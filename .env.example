# ============================================
# 🌌 Galaxy 3D AI Planner — Environment Config
# ============================================
# Скопируйте этот файл в .env и заполните своими значениями

# --- Ollama ---
# Адрес Ollama-сервера (используется Vite-прокси и fallback в браузере)
VITE_OLLAMA_ENDPOINT=http://localhost:11434
# Модель по умолчанию
VITE_DEFAULT_MODEL=llama2

# --- Vite Dev Server ---
VITE_DEV_SERVER_HOST=0.0.0.0
VITE_DEV_SERVER_PORT=3000
VITE_HMR_PORT=3001